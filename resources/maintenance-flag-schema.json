{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["changeRecord", "flags"],
  "properties": {
    "changeRecord": {
      "type": "string"
    },
    "flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["flag", "state", "description", "dependencies"],
        "properties": {
          "flag": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9:-]+$"
          },
          "state": {
            "type": "boolean"
          },
          "description": {
            "type": "string",
            "minLength": 20
          },
          "dependencies": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}